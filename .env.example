# Copy this file to .env and fill in your values.
# On Render, set these as Environment Variables in the dashboard.

# ── Core ──────────────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-your-secret-key-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,*.onrender.com

# ── Database (Render provides DATABASE_URL automatically) ────────────────────
DATABASE_URL=postgres://user:password@host:5432/dbname
# Local Postgres alternative (used if DATABASE_URL is not set):
# DB_NAME=hrms_db
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.onrender.com

# ── AWS S3 — required on Render (ephemeral disk = files lost on restart) ──────
# Create an S3 bucket, enable public access, and set bucket policy to allow GetObject.
USE_S3=True
AWS_STORAGE_BUCKET_NAME=your-hrms-bucket
AWS_S3_REGION_NAME=us-east-1
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Sentry error tracking ─────────────────────────────────────────────────────
# Get DSN from https://sentry.io → Project → Settings → Client Keys
SENTRY_DSN=https://xxxx@oXXXXX.ingest.sentry.io/XXXXXXX
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Celery & Redis ────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Cache ─────────────────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=60
